#!/bin/sh
# Runs before every push, including a plain `git push` that bypassed
# `npm run sync`. Nothing broken should reach a public repository, and the
# thirty seconds this costs is cheaper than a red badge on the front page.
#
# Skip deliberately with:  git push --no-verify

if [ -n "$BLACKNIGHT_SKIP_HOOKS" ]; then
  exit 0
fi

echo "pre-push: running tests..."
if ! npm test --silent >/dev/null 2>&1; then
  echo ""
  echo "  Tests failed. Push aborted."
  echo "  Run 'npm test' to see why, or 'git push --no-verify' to override."
  echo ""
  exit 1
fi

echo "pre-push: validating the catalog..."
if ! npm run check:catalog --silent >/dev/null 2>&1; then
  echo ""
  echo "  The catalog is not valid. Push aborted."
  echo "  Run 'npm run check:catalog' to see why."
  echo ""
  exit 1
fi

echo "pre-push: ok"
exit 0
