{
  "name": "blacknight-launcher",
  "productName": "BlackNight Launcher",
  "version": "1.1.0",
  "description": "The official game launcher for BlackNight Studios.",
  "author": "BlackNight Studios",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SourcedCMD/blacknight-launcher.git"
  },
  "homepage": "https://github.com/SourcedCMD/blacknight-launcher#readme",
  "bugs": {
    "url": "https://github.com/SourcedCMD/blacknight-launcher/issues"
  },
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dev:sample": "electron . --dev --sample-data",
    "test": "node --test --test-timeout=60000",
    "test:server": "cd server && node --test --test-timeout=60000",
    "check:budget": "node scripts/check-budget.js",
    "check:perf": "node scripts/perf.js",
    "art:snapshots": "node scripts/art-snapshots.js --write",
    "smoke": "node scripts/smoke.js",
    "services": "node server/index.js",
    "lint": "eslint .",
    "web": "node scripts/dev-server.js",
    "icon": "node scripts/make-icon.js",
    "og": "node scripts/make-og.js",
    "publish-title": "node scripts/publish-title.js",
    "winget": "node scripts/make-winget.js",
    "check:catalog": "node scripts/check-catalog.js",
    "doctor": "node scripts/doctor.js",
    "sync": "node scripts/sync.js",
    "release": "node scripts/release.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "prepare": "node scripts/setup-hooks.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1"
  },
  "build": {
    "appId": "com.blacknightstudios.launcher",
    "productName": "BlackNight Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      "CHANGELOG.md",
      "docs/TRUST.md",
      "docs/ARCHITECTURE.md"
    ],
    "protocols": [
      {
        "name": "BlackNight Launcher",
        "schemes": [
          "blacknight"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "BlackNightLauncher-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BlackNight Launcher",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "BlackNight Launcher"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SourcedCMD",
        "repo": "blacknight-launcher",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "BlackNightLauncher-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icons",
      "artifactName": "BlackNightLauncher-${version}.${ext}",
      "desktop": {
        "entry": {
          "Name": "BlackNight Launcher",
          "Categories": "Game;"
        }
      }
    },
    "electronLanguages": [
      "en-US"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "afterPack": "scripts/after-pack.js"
  }
}
